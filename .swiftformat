# SwiftFormat baseline
#
# Reference:
# https://github.com/nicklockwood/SwiftFormat/blob/main/Rules.md
#
# This config deliberately favours consistent, readable formatting over preserving
# compact source produced by humans or coding agents.

# Toolchain

--swiftversion 6.0

# Paths

--exclude .build,Build,DerivedData,Pods,Carthage,Generated,Vendor,Utilities/Sources/Utilities/String+Extensions.swift,ChagiLegacy/Sources/ChagiLegacy/Domain/FeatureFlags/FeatureFlag.swift,Utilities/Tests/UtilitiesTests/NSLockingRunTests.swift,Utilities/Tests/UtilitiesTests/GenericErrorTests.swift

# Utilities/Sources/Utilities/String+Extensions.swift:
# redundantSelf can remove a required explicit self receiver for NSString bridging.
#
# ChagiLegacy/Sources/ChagiLegacy/Domain/FeatureFlags/FeatureFlag.swift:
# redundantReturn breaks a CI check that expects the literal text "return false".
#
# Utilities/Tests/UtilitiesTests/NSLockingRunTests.swift:
# redundantThrows changes the Objective-C selector and causes an XCTest collision.
#
# Utilities/Tests/UtilitiesTests/GenericErrorTests.swift:
# semicolon splitting changes #line behaviour relied upon by the test.

# Indentation and whitespace

--indent 4
--tab-width 4
--smart-tabs enabled
--linebreaks lf
--trim-whitespace always
--indent-case false
--ifdef indent
--xcode-indentation disabled
--empty-braces no-space

# Wrapping
#
# 100 columns is intentionally stricter than the previous 120. This forces long
# calls generated by Claude/Codex into a more readable multiline form.

--max-width 100
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-conditions before-first
--wrap-type-aliases before-first
--closing-paren balanced
--call-site-paren balanced
--allow-partial-wrapping false
--func-attributes prev-line
--wrap-enum-cases always

# Braces and control flow

--allman false
--else-position same-line
--guard-else auto

# Language style

--strip-unused-args closure-only
--semicolons never
--trailing-commas never
--void-type void
--pattern-let hoist
--ranges spaced
--operator-func spaced

# Imports and comments

--import-grouping access-control,alpha,testable-last
--header ignore
--doc-comments before-non-local-declarations
--line-after-marks true

# Literals

--decimal-grouping 3,6
--binary-grouping 4,8
--octal-grouping 4,8
--hex-grouping 4,8
--hex-literal-case uppercase
--exponent-case lowercase
--asset-literals visual-width

# Additional rules
#
# Default SwiftFormat rules remain enabled. These opt-in rules increase consistency
# without enabling declaration reordering or other high-churn transformations.

--enable blankLinesAfterGuardStatements,isEmpty,preferContains,preferFirstWhere,preferMinOverSorted,singlePropertyPerLine,wrapEnumCases,wrapGuardStatementBodies,wrapMultilineConditionalAssignment,wrapMultilineFunctionChains,wrapSwitchCases,redundantStaticSelf

# wrapMultilineStatementBraces intentionally remains disabled.
#
# We want:
#
# if let foo,
#    let bar {
#     ...
# }
#
# rather than:
#
# if let foo,
#    let bar
# {
#     ...
# }
#
# It can also produce undesirable formatting around trailing closures.

--disable wrapMultilineStatementBraces
